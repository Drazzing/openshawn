{
  "auth": {
    "profiles": {
      "anthropic:default": { "provider": "anthropic", "mode": "api_key" },
      "xai:default": { "provider": "xai", "mode": "api_key" }
    },
    "order": {
      "anthropic": ["anthropic:default"],
      "xai": ["xai:default"]
    }
  },
  "models": {
    "providers": {
      "xai": {
        "baseUrl": "https://api.x.ai/v1",
        "api": "openai-completions",
        "models": [
          { "id": "grok-4-latest", "name": "Grok 4 Latest", "contextWindow": 131072, "maxTokens": 8192, "compat": {} },
          { "id": "grok-4", "name": "Grok 4", "contextWindow": 131072, "maxTokens": 8192, "compat": {} }
        ]
      }
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "auth": { "mode": "token" },
    "controlUi": { "allowInsecureAuth": true, "dangerouslyDisableDeviceAuth": false },
    "trustedProxies": []
  },
  "discovery": { "mdns": { "mode": "off" } },
  "session": { "dmScope": "per-channel-peer" },
  "logging": { "redactSensitive": "tools" },
  "cron": { "enabled": true, "maxConcurrentRuns": 1 },
  "skills": {
    "entries": {
      "coding-agent": { "enabled": true },
      "cursor-agent": { "enabled": true, "env": { "CURSOR_API_KEY": "" } },
      "overnight-dev": { "enabled": true, "env": { "CURSOR_API_KEY": "" } },
      "hcm-agent": { "enabled": true, "env": { "CURSOR_API_KEY": "" } }
    }
  },
  "agents": {
    "defaults": {
      "timeoutSeconds": 7200,
      "memorySearch": {
        "provider": "gemini",
        "model": "gemini-embedding-001",
        "remote": { "apiKey": "${GEMINI_API_KEY}" }
      },
      "models": {
        "anthropic/claude-opus-4-6": { "alias": "opus" },
        "anthropic/claude-sonnet-4-5": { "alias": "sonnet" },
        "anthropic/claude-haiku-4-5": { "alias": "haiku" },
        "xai/grok-4-latest": { "alias": "Grok" },
        "xai/grok-4": {}
      },
      "sandbox": {
        "mode": "off",
        "scope": "agent",
        "workspaceAccess": "none",
        "docker": {
          "image": "openclaw-sandbox:bookworm-slim",
          "workdir": "/workspace",
          "readOnlyRoot": true,
          "tmpfs": ["/tmp", "/var/tmp", "/run"],
          "network": "none",
          "user": "1000:1000",
          "capDrop": ["ALL"],
          "pidsLimit": 256,
          "memory": "1g",
          "memorySwap": "2g",
          "cpus": 1
        },
        "prune": { "idleHours": 24, "maxAgeDays": 7 }
      }
    },
    "list": [
      {
        "id": "opus",
        "default": true,
        "model": "anthropic/claude-opus-4-6",
        "workspace": "~/.openclaw/workspace-opus",
        "identity": {
          "name": "Opus",
          "theme": "senior architect and orchestrator — delegates tasks to Sonnet and Haiku agents, only handles high-level planning and complex decisions directly",
          "emoji": "🧠"
        }
      },
      {
        "id": "sonnet",
        "model": "anthropic/claude-sonnet-4-5",
        "workspace": "~/.openclaw/workspace-sonnet",
        "identity": {
          "name": "Sonnet",
          "theme": "middle management — receives tasks from Opus, breaks them down, coordinates with Haiku for execution, handles moderately complex work directly",
          "emoji": "📋"
        }
      },
      {
        "id": "haiku",
        "model": "anthropic/claude-haiku-4-5",
        "workspace": "~/.openclaw/workspace-haiku",
        "identity": {
          "name": "Haiku",
          "theme": "fast worker — executes tasks assigned by Opus or Sonnet, handles coding, file operations, and straightforward work quickly and cheaply",
          "emoji": "⚡"
        }
      }
    ]
  },
  "tools": {
    "agentToAgent": {
      "enabled": true,
      "allow": ["opus", "sonnet", "haiku"]
    },
    "sandbox": {
      "tools": {
        "allow": ["exec", "process", "read", "write", "edit", "sessions_list", "sessions_history", "sessions_send", "sessions_spawn", "session_status"],
        "deny": ["browser", "canvas", "nodes", "cron", "discord", "gateway"]
      }
    }
  },
  "messages": { "ackReactionScope": "group-mentions" },
  "commands": { "native": "auto", "nativeSkills": "auto" },
  "browser": { "enabled": false }
}
